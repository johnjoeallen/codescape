#!/usr/bin/env bash
# Launches the CodeScape repository-management service.
#
# Usage: codescape-service [--java-home <path>] [spring args...]
set -euo pipefail

DIST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DIST_DIR"

JAR="$(ls "$DIST_DIR"/lib/codescape-service-*.jar | head -n1)"

# Java selection, in priority order:
#   1. --java-home <path> given on this invocation
#   2. .java-home marker file (saved by a prior --java-home that validated OK)
#   3. JAVA_HOME environment variable
#   4. `java` on PATH
#   5. the bundled runtime under runtime/, as a last resort (with a warning)
#
# A compliant system Java is preferred over the bundled one because some
# corporate endpoint security software (e.g. Carbon Black) blocks
# execution of unsigned/bundled binaries — the runtime/ JVM we ship may
# simply not be runnable in a locked-down environment even though it's
# present and otherwise correct. --java-home/.java-home exist so a user
# can point at a compliant install without editing their shell profile's
# JAVA_HOME, which may be relied on by other tools.

JAVA_HOME_FILE="$DIST_DIR/.java-home"

java_major_version() {
  # grep across the whole output, THEN take the first match — not
  # `head -n1` before grep. Some environments force extra preamble lines
  # onto every JVM invocation before the real version line (e.g. a
  # globally-set JAVA_TOOL_OPTIONS makes the JVM print "Picked up
  # JAVA_TOOL_OPTIONS: ..." to stderr first), which head -n1-before-grep
  # would grab instead of the actual "openjdk version "N..."" line,
  # silently reporting no version found for a perfectly good install.
  "$1" -version 2>&1 | grep -oE '"[0-9]+' | head -n1 | tr -d '"'
}

is_java_25_plus() {
  local major
  major="$(java_major_version "$1" 2>/dev/null || true)"
  [ -n "$major" ] && [ "$major" -ge 25 ] 2>/dev/null
}

# Echoes a usable java binary under the given JAVA_HOME-style directory,
# or fails silently (no output, non-zero exit) if none found.
resolve_java_home_bin() {
  local home="$1" candidate
  for candidate in "$home/bin/java" "$home/bin/java.exe"; do
    if [ -f "$candidate" ] && is_java_25_plus "$candidate"; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# Prints why resolve_java_home_bin failed for a given directory: either no
# java binary was found under it, or one was found but running it failed
# or reported an unexpected version. Only used for --java-home, since
# that's the one interactive/user-invoked check worth explaining in
# detail — the .java-home/JAVA_HOME/PATH checks stay silent on failure.
explain_java_home_failure() {
  local home="$1" candidate
  for candidate in "$home/bin/java" "$home/bin/java.exe"; do
    if [ -f "$candidate" ]; then
      echo "codescape:   found '$candidate'; running \"$candidate\" -version gave:" >&2
      "$candidate" -version 2>&1 | sed 's/^/codescape:     /' >&2
      return
    fi
  done
  echo "codescape:   no bin/java or bin/java.exe found under '$home'." >&2
}

# Strip --java-home/--java-home=<path> out of the args before they reach
# the jar; keep everything else in original order.
JAVA_HOME_FLAG=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --java-home)
      JAVA_HOME_FLAG="${2:-}"
      shift 2
      ;;
    --java-home=*)
      JAVA_HOME_FLAG="${1#--java-home=}"
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

JAVA_BIN=""

if [ -n "$JAVA_HOME_FLAG" ]; then
  if JAVA_BIN="$(resolve_java_home_bin "$JAVA_HOME_FLAG")"; then
    printf '%s\n' "$JAVA_HOME_FLAG" > "$JAVA_HOME_FILE"
    echo "codescape: using Java 25+ at '$JAVA_HOME_FLAG' (saved to $JAVA_HOME_FILE — will be used automatically next time, no need to pass --java-home again)" >&2
  else
    echo "codescape: --java-home '$JAVA_HOME_FLAG' doesn't look like a Java 25+ install; ignoring it and checking other options." >&2
    explain_java_home_failure "$JAVA_HOME_FLAG"
  fi
fi

if [ -z "$JAVA_BIN" ] && [ -f "$JAVA_HOME_FILE" ]; then
  SAVED_JAVA_HOME="$(head -n1 "$JAVA_HOME_FILE" 2>/dev/null || true)"
  if [ -n "$SAVED_JAVA_HOME" ]; then
    JAVA_BIN="$(resolve_java_home_bin "$SAVED_JAVA_HOME" || true)"
  fi
fi

if [ -z "$JAVA_BIN" ] && [ -n "${JAVA_HOME:-}" ]; then
  JAVA_BIN="$(resolve_java_home_bin "$JAVA_HOME" || true)"
fi

if [ -z "$JAVA_BIN" ] && command -v java >/dev/null 2>&1 && is_java_25_plus java; then
  JAVA_BIN="java"
fi

if [ -z "$JAVA_BIN" ]; then
  # Existence checks (-f), not -x, for both candidates: the archive's zip
  # entries don't carry a Unix exec bit for either (built with `jar cf`,
  # since windows-latest's Git Bash has no `zip` — see release.yml), and
  # -x on the extensionless name is not reliable on Windows either — MSYS
  # can report it true (transparently resolving to the .exe for the stat
  # check) while the subsequent exec still fails with "Permission
  # denied", which was happening in practice. Existence is all we can
  # trust here; actual usability is proven by exec'ing it below.
  if [ -f "$DIST_DIR/runtime/bin/java" ]; then
    JAVA_BIN="$DIST_DIR/runtime/bin/java"
  elif [ -f "$DIST_DIR/runtime/bin/java.exe" ]; then
    JAVA_BIN="$DIST_DIR/runtime/bin/java.exe"
  fi

  if [ -n "$JAVA_BIN" ]; then
    echo "codescape: no system Java 25+ found via --java-home, .java-home, JAVA_HOME, or PATH; falling back to the bundled runtime under runtime/. If your environment blocks running bundled/unsigned executables (e.g. Carbon Black or similar endpoint security software), install Java 25+ and pass --java-home <path>, or set JAVA_HOME/PATH, instead." >&2
  else
    JAVA_BIN="java"
  fi
fi

# Git Bash/MSYS auto-translates a *bare* POSIX-style path argument (like
# $JAR above) to a native Windows path when invoking a non-MSYS program
# such as java.exe — but not a path embedded inside a larger string like
# a "file:" URI, which is exactly what this flag is. Without this, Spring
# Boot on Windows gets handed a literal "file:/c/Users/.../config/" URI,
# which doesn't resolve to anything on a real Windows filesystem, and
# fails to start ("Config data location ... does not exist"). cygpath
# (bundled with Git for Windows) gives the real Windows-style path
# (C:/Users/... — forward slashes, which both Windows and Spring's file:
# URI handling accept) to embed instead.
CONFIG_DIR="$DIST_DIR/config/"
if command -v cygpath >/dev/null 2>&1; then
  CONFIG_DIR="$(cygpath -m "$CONFIG_DIR")"
fi

exec "$JAVA_BIN" -jar "$JAR" \
  --spring.config.additional-location="file:$CONFIG_DIR" \
  "$@"
