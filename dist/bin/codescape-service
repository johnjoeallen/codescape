#!/usr/bin/env bash
# Launches the CodeScape repository-management service.
set -euo pipefail

DIST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JAR="$(ls "$DIST_DIR"/lib/codescape-service-*.jar | head -n1)"

JAVA_BIN="java"
if [ -x "$DIST_DIR/runtime/bin/java" ]; then
  JAVA_BIN="$DIST_DIR/runtime/bin/java"
elif [ -f "$DIST_DIR/runtime/bin/java.exe" ]; then
  # Windows build's jlink runtime — reached when this script runs under
  # Git Bash/MSYS/WSL rather than the .bat launcher. Existence check
  # (-f), not -x: the archive's zip entries don't carry a Unix exec bit
  # for this file (built with `jar cf`, since windows-latest's Git Bash
  # has no `zip` — see release.yml), so MSYS's permission emulation sees
  # it as non-executable after extraction even though Windows itself
  # doesn't care and will happily run any .exe regardless of that bit.
  JAVA_BIN="$DIST_DIR/runtime/bin/java.exe"
fi

exec "$JAVA_BIN" -jar "$JAR" \
  --spring.config.additional-location="file:$DIST_DIR/config/" \
  "$@"
